+package com.mjstudio.reactnativenavermap.event
+
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.uimanager.events.Event
+
+/**
+ * 지도 최초 로딩 완료 (NaverMap.OnLoadListener) — "지도의 데이터가 모두 로딩되어 최초로
+ * 화면에 나타나면" 1회 발화한다. 기존 `topInitialized`(= getMapAsync 콜백 = 지도 객체 생성)와
+ * 다르다: 초기화는 타일이 그려지기 훨씬 전에 온다.
+ */
+class NaverMapLoadedEvent(
+  surfaceId: Int,
+  viewId: Int,
+) : Event<NaverMapLoadedEvent>(surfaceId, viewId) {
+  override fun getEventName(): String = EVENT_NAME
+
+  override fun canCoalesce(): Boolean = false
+
+  override fun getCoalescingKey(): Short = 0
+
+  override fun getEventData(): WritableMap = Arguments.createMap()
+
+  companion object {
+    const val EVENT_NAME = "topLoaded"
+  }
+}
