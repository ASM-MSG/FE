# 이 파일을 .env.local로 복사한 뒤 값을 채운다 (.env.local은 커밋되지 않음)

# 네이버 지도(NCP Maps) Client ID — 스크립트 로드 시 ncpKeyId 파라미터로 주입된다
# NCP 콘솔 > Maps > Application 등록 후 발급 (레거시 AI·NAVER API 경로 아님)
# - Web Dynamic Map + Reverse Geocoding 두 API 활성화 필요
# - Web 서비스 URL에 http://localhost:5173 등록 필요
VITE_NAVER_MAP_NCP_KEY_ID=your_ncp_maps_client_id

# [삭제됨] VITE_KAKAO_JS_KEY / VITE_KAKAO_LOGIN_ENABLED — 둘 다 코드가 읽지 않는다 (MSG-451 확인).
# 카카오 로그인은 **서버 진입점**(/api/auth/oauth/kakao/authorize) 경유라 앱 키·scope·nonce가
# 전부 서버 몫이고, 프론트에는 카카오 키가 필요한 경로 자체가 없다(kakao-oauth.ts 주석).
# 인가 코드 교환(POST /api/auth/oauth/kakao/code)도 이미 붙어 있어 활성 플래그도 무의미하다 —
# "서버 교환 엔드포인트가 아직 없다"던 종전 주석은 스테일이었다.
# 프론트가 카카오에 요구하는 것은 값이 아니라 **Redirect URI 등록**뿐이다 (docs/DEPLOYMENT.md).

# API 서버 베이스 URL — hey-api 클라이언트의 baseUrl로 주입된다 (src/shared/api/client-config.ts)
# 코드 폴백 없음: 미설정 시 API 호출이 즉시 실패해 드러난다 (조용한 오배포 방지)
# CORS는 http://localhost:5173 직접 호출을 허용하므로 dev 프록시 불필요 (2026-08-06 실측)
VITE_API_BASE_URL=https://api.fillmap.kr
