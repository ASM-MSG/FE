# .env로 복사한 뒤 값을 채운다 — .env는 gitignore (키 실값 커밋 금지)
# 네이버 지도 클라이언트 키(ncpKeyId): NCP 콘솔 > Maps > Application "FillMap"
# 웹과 같은 Application을 쓴다 — 그 Application에 Web 서비스 URL과 Android 패키지명
# (kr.fillmap.app)이 함께 등록돼 있어 apps/web/.env.local의 값을 그대로 재사용한다.
# 변수명만 플랫폼별로 다르다: 웹 VITE_NAVER_MAP_NCP_KEY_ID / 모바일 EXPO_PUBLIC_NAVER_MAP_CLIENT_ID
# 키를 넣거나 바꾼 뒤에는 `npx expo prebuild -p android` 재실행 + 네이티브 재빌드 필요
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# FillMap API 베이스 URL (MSG-419) — 웹 VITE_API_BASE_URL 대응.
# 코드 폴백이 없다: 미설정이면 앱 부트 시점에 throw한다(조용한 오배포 방지).
# 예외 — 온디바이스 Storybook(EXPO_PUBLIC_STORYBOOK=1)은 UI 전용이라 이 값 없이도 뜬다.
# 대신 그 모드에서 API를 호출하면 같은 메시지로 즉시 실패한다(폴백 URL로 나가지 않는다).
EXPO_PUBLIC_API_BASE_URL=https://api.fillmap.kr

# 카카오 네이티브 앱 키 (MSG-444) — 콘솔 > 내 애플리케이션 > 앱 키 > **네이티브 앱 키**
# 웹이 쓰는 REST API 키와 다른 값이다. 네이티브 앱 키는 클라이언트 공개를 전제로 한 키라
# EXPO_PUBLIC_ 노출이 정상이며, 카카오 콘솔의 아래 두 등록이 보호 장치다:
#   - 플랫폼 > Android: 패키지명 kr.fillmap.app
#   - 키 해시(디버그): Xo8WBi6jzSxKDVR4drqm84yr9iU=  (Expo/RN 템플릿 표준 debug.keystore)
#     릴리스 빌드는 서명 키의 해시를 별도로 등록해야 한다
# 또한 카카오 로그인 활성화 + **OpenID Connect 활성화**가 켜져 있어야 한다 — ID 토큰이
# 안 내려오면 앱이 "설정에 문제가 있어요"로 실패한다(서버를 부르지 않는다).
# 값을 넣거나 바꾼 뒤에는 `npx expo prebuild -p android --clean` + 네이티브 재빌드 필요.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
