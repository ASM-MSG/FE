{
  "name": "fillmap-fe",
  "version": "1.0.0",
  "private": true,
  "description": "FillMap 모노레포 — 웹(React) + 앱(React Native, 추후) 디자인 시스템 기반",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter web test run",
    "openapi-ts": "pnpm --filter web openapi-ts",
    "storybook": "pnpm --filter @fillmap/ui-web storybook",
    "build-storybook": "pnpm --filter @fillmap/ui-web build-storybook",
    "prepare": "husky"
  },
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
