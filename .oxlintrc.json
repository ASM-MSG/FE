{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // MSG-386: eslint 4개 설정을 oxlint 단일 설정으로 이식 — 규칙 정본은 이 파일 하나다.
  // 토큰 규칙(디자인 시스템 1조)은 JS 플러그인(tools/oxlint/)으로 구현 — jsPlugins는 alpha API.
  "jsPlugins": ["./tools/oxlint/no-restricted-classes.mjs"],
  "plugins": ["eslint", "unicorn", "typescript", "oxc", "react"],
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "**/dist",
    "apps/web/src/shared/api/generated",
    "apps/mobile/.expo",
    "apps/mobile/expo-env.d.ts",
    "apps/mobile/.rnstorybook/storybook.requires.ts",
    "packages/ui-web/storybook-static",
    "_workspace",
    ".claude"
  ],
  "rules": {
    // react-hooks recommended 상당 — 원본 eslint 구성과 동일한 심각도(error/warn)
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    // 디자인 시스템 1조 기계 강제 (better-tailwindcss/no-restricted-classes 이식)
    "fillmap/no-restricted-classes": "error"
  },
  "overrides": [
    {
      // react-refresh vite 프리셋 상당(only-export-components + allowConstantExport)
      // — Fast Refresh는 vite(apps/web)에서만 의미가 있으므로 원본과 동일하게 web 한정
      "files": ["apps/web/**"],
      "rules": {
        "react/only-export-components": [
          "error",
          { "allowConstantExport": true }
        ]
      }
    },
    {
      // RN 대비 경계 규칙(page-implementation 스킬) 기계 강제 — 로직 레이어는 플랫폼 중립.
      // widgets/pages의 뷰-레이어 훅(라우터 연결용)은 이 glob에 안 걸리므로 예외가 자동 성립한다.
      "files": [
        "apps/web/src/features/*/model/**",
        "apps/web/src/entities/*/model/**",
        "apps/web/src/widgets/**/*-store.*"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["react-router*"],
                "message": "model 레이어는 라우터를 몰라야 합니다(RN 재사용 대상). 네비게이션은 콜백 주입 또는 뷰-레이어 훅에서 처리하세요."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "window",
            "message": "model 레이어에서 window 직접 접근 금지 — shared/ 어댑터를 경유하세요 (RN 경계 규칙)"
          },
          {
            "name": "document",
            "message": "model 레이어에서 document 직접 접근 금지 — shared/ 어댑터를 경유하세요 (RN 경계 규칙)"
          },
          {
            "name": "localStorage",
            "message": "localStorage 직접 접근 금지 — shared/의 storage 어댑터를 사용하세요 (RN 경계 규칙)"
          }
        ]
      }
    },
    {
      // Hermes 미구현 API 차단 (MSG-427 실기 사고) — RN 런타임은 Hermes(RN 0.86 / Hermes 0.17)라
      // ES2023 change-array-by-copy 등이 없다. vitest는 Node에서 돌고 typecheck의 lib에는 ES2023이
      // 있어 **게이트 6종이 원리적으로 못 잡는다** — 웹에서 포팅해 온 코드가 런타임에서만 터진다.
      // MSG-427에서 `toSorted` 3곳이 지도 홈을 마운트 즉시 크래시시켰고, 같은 함정이 이미 두 번
      // 주석으로 문서화돼 있었는데도 재발했다(gallery-groups.ts · region-cluster-overlay.ts).
      // 대안: 스프레드 복사 + 제자리 메서드 (`[...arr].sort(...)` — `sort`는 ES2019부터 안정 정렬).
      "files": ["apps/mobile/**", "packages/ui-native/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "toSorted",
            "message": "Hermes 미구현 — `[...arr].sort(...)`를 쓰세요 (sort는 ES2019부터 안정 정렬)"
          },
          {
            "property": "toReversed",
            "message": "Hermes 미구현 — `[...arr].reverse()`를 쓰세요"
          },
          {
            "property": "toSpliced",
            "message": "Hermes 미구현 — 복사 후 `splice`를 쓰세요"
          },
          {
            "object": "Object",
            "property": "groupBy",
            "message": "Hermes 미구현 — `reduce`로 그룹핑하세요"
          },
          {
            "object": "Map",
            "property": "groupBy",
            "message": "Hermes 미구현 — `reduce`로 그룹핑하세요"
          },
          {
            "object": "Promise",
            "property": "withResolvers",
            "message": "Hermes 미구현 — `new Promise`로 resolve/reject를 꺼내 쓰세요"
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "structuredClone",
            "message": "Hermes 미구현 — 명시적 복사나 직렬화 왕복을 쓰세요"
          }
        ]
      }
    },
    {
      // apps/mobile의 순수 JS 파일(metro 설정 등)은 commonjs+node 컨텍스트
      "files": ["apps/mobile/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
